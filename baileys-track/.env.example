# Copiá este archivo a .env y completá los valores

# URL del webhook nuevo en n8n (NO el mismo que usás para el número de Cloud API)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/cadi-grupo
# Opcional (recomendado): clave que el bridge manda en el header "x-cadi-token". Si la cargás,
# configurá el Webhook1 de n8n con Header Auth (nombre: x-cadi-token, valor: la misma clave)
# y nadie más va a poder hacerse pasar por el bridge.
N8N_WEBHOOK_TOKEN=

# Puerto donde este bridge escucha las llamadas de n8n (/send, /group/*, /memoria/*...)
BRIDGE_PORT=3001

# Vinculación: dejá esto en "false" para escanear QR (más simple para arrancar).
# Si preferís el código de emparejamiento (sin QR), poné "true" y cargá el número abajo.
USE_PAIRING_CODE=false
PAIRING_PHONE_NUMBER=

# Admins de CaDI: JIDs separados por coma, tal como los imprime la terminal en "senderJid:".
# Solo ellos reciben nivel ADMINISTRADOR. Ej: ADMIN_JIDS=123456789012345@lid,549XXXXXXXXXX@s.whatsapp.net
ADMIN_JIDS=

# Nombre con el que CaDI se da por aludida en grupos (además de @mención o respuesta a un mensaje suyo)
BOT_NAME=CaDI

# Zona horaria de CaDI (fechas de la memoria, eventos y resúmenes)
ZONA_HORARIA=America/Argentina/Tucuman

# --- Memoria (se guarda en data/cadi.db, que nunca se sube a GitHub) ---
# false = no guarda nada (CaDI vuelve a no tener memoria)
MEMORIA_ACTIVA=true
# Cuántos de los últimos mensajes del chat ve el modelo en cada respuesta, y de hasta cuántas horas atrás
CONTEXTO_MENSAJES=15
CONTEXTO_HORAS=12
# Resúmenes diarios que ve el modelo (los arma el workflow "CaDI - Resumen diario"; 0 = ninguno)
RESUMENES_DIAS=3
# Borrar mensajes con más de X días (0 = no borrar nunca)
MEMORIA_DIAS=0
# Personas que pidieron que CaDI no guarde sus mensajes (JIDs separados por coma)
MEMORIA_EXCLUIR=

# --- @todos ---
# Palabras que hacen que CaDI etiquete a todos (separadas por coma)
PALABRAS_TODOS=@todos,@all,@everyone,@todes
# Minutos mínimos entre dos "@todos" en el mismo grupo (los admins no esperan)
TODOS_ESPERA_MIN=10

# --- Imágenes ---
# cloudflare (recomendado: gratis, ~170 imágenes por día) o pollinations (necesita clave y saldo)
IMAGEN_PROVEEDOR=cloudflare
# Cloudflare Workers AI (cuenta gratis): panel de Cloudflare → Workers AI → "Use REST API" →
# "Create a Workers AI API Token" → copiá el token. En esa misma página está el Account ID.
CF_ACCOUNT_ID=
CF_API_TOKEN=
# Pollinations (solo si IMAGEN_PROVEEDOR=pollinations): clave secreta sk_... de enter.pollinations.ai
POLLINATIONS_KEY=
# Topes para cuidar la cuota gratis (los admins no tienen tope)
IMAGEN_MAX_DIA=25
IMAGEN_ESPERA_SEG=60

# --- Ubicaciones (OpenStreetMap, gratis y sin clave) ---
# Opcional: un mail de contacto que se manda a Nominatim, como pide su política de uso
NOMINATIM_EMAIL=

# --- Estabilidad (opcionales; los valores por defecto andan bien) ---
# Mensajes más viejos que esto (segundos) no se contestan (sí se guardan en la memoria):
# evita que CaDI conteste de golpe todo lo que se dijo mientras estaba desconectada.
MAX_ANTIGUEDAD_SEG=300
# false = solo se mandan a n8n los mensajes dirigidos a CaDI (menos carga para n8n)
REENVIAR_TODO=false
# Nivel de logs: el de Baileys en "warn" evita llenar la consola
LOG_LEVEL=info
LOG_LEVEL_BAILEYS=warn
