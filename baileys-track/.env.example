# Copiá este archivo a .env y completá los valores

# URL del webhook nuevo en n8n (NO el mismo que usás para el número de Cloud API)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/cadi-grupo

# Puerto donde este bridge escucha las llamadas de n8n (/send, /group/*)
BRIDGE_PORT=3001

# Vinculación: dejá esto en "false" para escanear QR (más simple para arrancar).
# Si preferís el código de emparejamiento (sin QR), poné "true" y cargá el número abajo.
USE_PAIRING_CODE=false
PAIRING_PHONE_NUMBER=

# Admins de CaDI: JIDs separados por coma, tal como los imprime la terminal en "senderJid:".
# Solo ellos reciben nivel ADMINISTRADOR. Ej: ADMIN_JIDS=123456789012345@lid,549XXXXXXXXXX@s.whatsapp.net
ADMIN_JIDS=

# Nombre con el que CaDI se da por aludida en grupos (además de @mención o respuesta a un mensaje suyo)
BOT_NAME=CaDI
